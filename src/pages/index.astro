---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Seasoned Steel" description="Seasoning, restoring, and cooking with cast iron and carbon steel — tested guides with exact temperatures, times, and honest answers.">
  <h1>Seasoned Steel</h1>
  <p>Seasoning, restoring, and cooking with cast iron and carbon steel. Tested guides, exact numbers, no myths.</p>
  {posts.length === 0 && <p><em>First guides are in the works — check back soon.</em></p>}
  <ul class="article-list">
    {posts.map((p) => (
      <li>
        <a href={`/articles/${p.id.replace(/^\d+-/, '')}/`}>{p.data.title}</a>
        <div class="date">{p.data.pubDate.toISOString().slice(0, 10)}</div>
      </li>
    ))}
  </ul>
</Base>
